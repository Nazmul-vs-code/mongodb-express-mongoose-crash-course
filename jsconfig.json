{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "types": ["node", "mongoose", "mongodb"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.js"]
}
